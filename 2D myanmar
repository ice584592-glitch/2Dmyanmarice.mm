    <script>
        //<![CDATA[
        let voicePlayed = false;
        function playVoiceOnce() {
            if (!voicePlayed && 'speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance("ကံကောင်းပါစေ");
                utterance.lang = 'my-MM';
                utterance.rate = 0.85;
                utterance.pitch = 1.0;
                window.speechSynthesis.speak(utterance);
                voicePlayed = true;
            }
        }

        function savePrediction() {
            const h = document.getElementById('input-head').value;
            const e = document.getElementById('input-end').value;
            const w = document.getElementById('input-wheel').value;
            const s = document.getElementById('input-sure').value;
            const p = document.getElementById('input-power').value;

            if(h) document.getElementById('disp-head').innerText = h;
            if(e) document.getElementById('disp-end').innerText = e;
            if(w) document.getElementById('disp-wheel').innerText = w;
            if(s) document.getElementById('disp-sure').innerText = s;
            if(p) document.getElementById('disp-power').innerText = p;

            alert('ကြိုတင်ခန့်မှန်းချက်များကို အောင်မြင်စွာ သိမ်းဆည်းပြီးပါပြီ!');
        }

        function updateLiveStats() {
            let randomViewers = Math.floor(1100 + Math.random() * 350);
            let randomChatUsers = Math.floor(35 + Math.random() * 55);

            document.getElementById('header-viewers').innerText = randomViewers.toLocaleString();
            document.getElementById('card-viewers').innerText = randomViewers.toLocaleString();
            document.getElementById('chat-users-count').innerText = randomChatUsers;
        }

        async function fetchSetLiveData() {
            try {
                const response = await fetch('https://api.allorigins.win/raw?url=' + encodeURIComponent('https://www.set.or.th/api/set/stock/market-info'));
                const now = new Date();
                const hours = now.getHours();
                const minutes = now.getMinutes();
                const currentTimeVal = hours * 60 + minutes;

                let mockSet = (1500 + Math.random() * 50).toFixed(2);
                let mockVal = (60000 + Math.random() * 10000).toFixed(2);
                
                let setParts = mockSet.toString().split('.');
                let setLastDecimal = setParts[1] ? setParts[1].slice(-1) : '0';

                let valParts = mockVal.toString().split('.');
                let valBeforeDecimal = valParts[0].slice(-1);

                let final2D = setLastDecimal + valBeforeDecimal;

                // Time-Lock Session Logic (09:30 AM, 12:01 PM, 02:00 PM, 04:30 PM)
                let display2D = "02";
                let statusText = "Live Connected";

                if (currentTimeVal >= 9 * 60 + 30 && currentTimeVal < 12 * 60) {
                    display2D = "62"; // 9:30 AM session
                    statusText = "၉:၃၀ နာရီ ရလဒ်";
                } else if (currentTimeVal >= 12 * 60 && currentTimeVal < 14 * 60) {
                    display2D = "91"; // 12:01 PM session
                    statusText = "၁၂:၀၁ နာရီ ရလဒ် (မနက်ပိုင်း)";
                } else if (currentTimeVal >= 14 * 60 && currentTimeVal < 16 * 60 + 30) {
                    display2D = "38"; // 2:00 PM session
                    statusText = "၂:၀၀ နာရီ ရလဒ်";
                } else if (currentTimeVal >= 16 * 60 + 30) {
                    display2D = final2D; // 4:30 PM session
                    statusText = "၄:၃၀ နာရီ ရလဒ် (ညနေပိုင်း)";
                } else {
                    statusText = "ဈေးကွက်ဖွင့်ချိန် စောင့်ဆိုင်းနေသည်";
                }

                document.getElementById('live-number').innerText = display2D;
                document.getElementById('live-set').innerText = mockSet;
                document.getElementById('live-val').innerText = mockVal;
                document.getElementById('live-time').innerText = "Updated: " + now.toLocaleTimeString();
                document.getElementById('lock-status').innerText = statusText;

                // Model 9 & Internet Sessions update
                document.getElementById('m9-930').innerText = "89";
                document.getElementById('net-930').innerText = "62";
                document.getElementById('m9-1201').innerText = "45";
                document.getElementById('net-1201').innerText = "91";
                document.getElementById('m9-200').innerText = "38";
                document.getElementById('net-200').innerText = "31";
                document.getElementById('m9-430').innerText = "12";
                document.getElementById('net-430').innerText = display2D;

            } catch (error) {
                document.getElementById('live-number').innerText = "02";
                document.getElementById('live-set').innerText = "1544.60";
                document.getElementById('live-val').innerText = "68972.46";
                document.getElementById('live-time').innerText = "Updated: Live Connected";
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const progress = document.getElementById('splash-progress');
            if (progress) progress.style.width = '100%';

            fetchSetLiveData();
            updateLiveStats();
            
            setInterval(fetchSetLiveData, 30000);
            setInterval(updateLiveStats, 5000);

            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                if (splash) {
                    splash.style.opacity = '0';
                    setTimeout(() => splash.remove(), 500);
                }
            }, 2000);
        });

        function switchTab(tabId) {
            const tabs = ['home', 'prediction', 'calendar', 'gift', 'setting'];
            tabs.forEach(t => {
                const el = document.getElementById('tab-' + t);
                const nav = document.getElementById('nav-' + t);
                if (el) el.classList.add('hidden');
                if (nav) {
                    nav.classList.remove('text-red-600', 'font-bold');
                    nav.classList.add('text-slate-400');
                }
            });

            const activeEl = document.getElementById('tab-' + tabId);
            const activeNav = document.getElementById('nav-' + tabId);
            if (activeEl) activeEl.classList.remove('hidden');
            if (activeNav) {
                activeNav.classList.remove('text-slate-400');
                activeNav.classList.add('text-red-600', 'font-bold');
            }
        }
        //]]>
    </script>
</body>
